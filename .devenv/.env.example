# Copy to .env (`make init` does this) and adjust.

# ---------------------------------------------------------------- auth mode --
# none = unauthenticated, fastest loop
# saml = Keycloak SAML SSO for the browser + JWT for ngb-cli (requires `make up-saml`)
AUTH_MODE=none

# ------------------------------------------------------------- JDK selection --
# Which JDK runs the NGB jar. The jar is built against a Java 21 toolchain, so 21 is the only
# value that runs it - 17 fails on the class file version. The setting stays because the image
# still carries a second JDK: 17, for `server/ngb-cli`'s toolchain (see CLI_JAVA_VERSION).
NGB_JAVA_VERSION=21

# Extra JVM flags, for experiments only. Flags the app *needs* on a given JDK live in
# ngb/entrypoint.sh (JAVA_REQUIRED_OPTS), so that they apply without editing this file.
# That set is empty: the four --add-opens it used to carry existed for EhCache 2's reflective
# heap sizing, and EhCache was replaced by Caffeine, which reflects on nothing.
# JAVA_EXTRA_OPTS=--add-opens=java.base/java.lang=ALL-UNNAMED
JAVA_EXTRA_OPTS=

NGB_HEAP=2g

# ------------------------------------------------------------------ database --
# 16 is what NGB is tested against; the JDBC driver (42.7.x) and Flyway 11.7.2 accept 9.6 - 17.
# A data directory written by one major version is unreadable by the next, so `make reset-pg` is
# mandatory when changing this - and note that reset-pg destroys the cluster, it does not migrate
# it. The operator procedure for a real upgrade is docs/md/installation/database-upgrade.md.
PG_VERSION=16

# ---------------------------------------------------------------------- SAML --
KEYSTORE_PASS=changeit
HTTPS_KEY_ALIAS=ngb-https
SAML_SIGN_KEY=ngb-saml
SAN_HOSTS=ngb.dev.local,ngb-pg.dev.local,localhost
DEFAULT_ADMIN=ngbadmin@ngb.dev.local

KEYCLOAK_VERSION=26.0
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------- CLI --
CLI_SERVER_URL=http://ngb.dev.local:8080/catgenome
# Paste a JWT here when running in SAML mode (UI -> user menu -> generate token)
CLI_TOKEN=
