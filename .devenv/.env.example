# Copy to .env (`make init` does this) and adjust.

# ---------------------------------------------------------------- auth mode --
# none = unauthenticated, fastest loop
# saml = Keycloak SAML SSO for the browser + JWT for ngb-cli (requires `make up-saml`)
AUTH_MODE=none

# ------------------------------------------------------------- JDK selection --
# Which JDK runs the NGB jar. 8 = today's baseline, 21 = the migration target.
# The jar itself is always built by Gradle 3.3 on JDK 8 until the build is migrated.
NGB_JAVA_VERSION=8

# Extra JVM flags. Old libraries (Spring 4, c3p0, ehcache 2, hadoop 2.2) often need
# these once you actually try to run on JDK 21 - uncomment as needed:
# JAVA_EXTRA_OPTS=--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.text=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED
JAVA_EXTRA_OPTS=

NGB_HEAP=2g

# ------------------------------------------------------------------ database --
# Flyway 3.2.1 rejects modern PostgreSQL; 9.6 matches what the current code supports.
# Bump to 16 as part of the Flyway upgrade step (and run `make reset-pg` first).
PG_VERSION=9.6

# ---------------------------------------------------------------------- SAML --
KEYSTORE_PASS=changeit
HTTPS_KEY_ALIAS=ngb-https
SAML_SIGN_KEY=ngb-saml
SAN_HOSTS=ngb.dev.local,ngb-pg.dev.local,localhost
DEFAULT_ADMIN=ngbadmin@ngb.dev.local

KEYCLOAK_VERSION=26.0
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------- CLI --
CLI_SERVER_URL=http://ngb.dev.local:8080/catgenome
# Paste a JWT here when running in SAML mode (UI -> user menu -> generate token)
CLI_TOKEN=
