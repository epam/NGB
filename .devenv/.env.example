# Copy to .env (`make init` does this) and adjust.

# ---------------------------------------------------------------- auth mode --
# none = unauthenticated, fastest loop
# saml = Keycloak SAML SSO for the browser + JWT for ngb-cli (requires `make up-saml`)
AUTH_MODE=none

# ------------------------------------------------------------- JDK selection --
# Which JDK runs the NGB jar. Since migration Phase 3 the jar is built by Gradle 8 against a
# Java 21 toolchain, so 21 is the only value that runs it - 8 and 17 will fail on the class
# file version. The setting stays because the app image still carries all three JDKs.
NGB_JAVA_VERSION=21

# Extra JVM flags, for experiments only. Flags the app *needs* on a given JDK live in
# ngb/entrypoint.sh (JAVA_REQUIRED_OPTS), so that they apply without editing this file.
# That set is empty since Phase 3: the four --add-opens in it existed for EhCache 2's
# reflective heap sizing, and D11 replaced EhCache with Caffeine.
# JAVA_EXTRA_OPTS=--add-opens=java.base/java.lang=ALL-UNNAMED
JAVA_EXTRA_OPTS=

NGB_HEAP=2g

# ------------------------------------------------------------------ database --
# Flyway 3.2.1 rejects modern PostgreSQL; 9.6 matches what the current code supports.
# Bump to 16 as part of the Flyway upgrade step (and run `make reset-pg` first).
PG_VERSION=9.6

# ---------------------------------------------------------------------- SAML --
KEYSTORE_PASS=changeit
HTTPS_KEY_ALIAS=ngb-https
SAML_SIGN_KEY=ngb-saml
SAN_HOSTS=ngb.dev.local,ngb-pg.dev.local,localhost
DEFAULT_ADMIN=ngbadmin@ngb.dev.local

KEYCLOAK_VERSION=26.0
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------- CLI --
CLI_SERVER_URL=http://ngb.dev.local:8080/catgenome
# Paste a JWT here when running in SAML mode (UI -> user menu -> generate token)
CLI_TOKEN=
