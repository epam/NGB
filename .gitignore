/dist
/docs/site
/.gradle
# Gradle 8 writes its incubating "problems report" into the root project's build dir on every
# invocation, so the root gets a build/ of its own now. The modules ignore theirs locally.
/build

# build outputs the gradle build writes into the source tree, not into build/:
# `ui` drops webpack bundles into the server's static resources, `templates` writes
# export/, and the test task creates contents/ plus directories literally named after
# unresolved ${...} properties.
/contents/
# a server started from the repository root - `java -jar dist/catgenome.jar`, or the CLI
# integration suite - writes its log4j2 output beside itself, since the `jar` profile's
# log4j2.xml names ./logs/ relative to the working directory
/logs/
/server/catgenome/${*
/server/catgenome/src/main/resources/export/
/server/catgenome/src/main/resources/static/docs/
/server/catgenome/src/main/resources/static/static/
/server/catgenome/src/main/resources/static/*.bundle.*.js
/server/catgenome/src/main/resources/static/app.*.css
/server/catgenome/src/main/resources/static/vendors.*.css
/server/catgenome/src/main/resources/static/error-401.html
/server/catgenome/src/main/resources/static/ngb-logo.png

# fixtures the CLI integration suite stages before it runs and deletes afterwards
# (e2e/cli/prepare_test_data.sh generates them from the server module's test resources)
/e2e/cli/test_data/

# containerised dev environment (.devenv): local state, never committed
/.devenv/.env
/.devenv/secrets/
/.devenv/data/*
!/.devenv/data/ngs/
/.devenv/data/ngs/*
!/.devenv/data/ngs/.gitkeep
/.devenv/ngb/override.properties
# jwt-token.py imports saml-login-test.py, and importing writes bytecode next to it
/.devenv/scripts/__pycache__/
# Captured pre-migration databases, used to exercise migration Phase 5's upgrade path.
# Binary blobs of local state - but the README is the recipe for rebuilding them, and
# scripts/verify-lucene.sh points at it for the data it expects, so that one is committed.
/.devenv/fixtures/*
!/.devenv/fixtures/README.md
