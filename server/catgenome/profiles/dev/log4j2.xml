<?xml version="1.0" encoding="UTF-8"?>
<!--
  Translated from the log4j 1.2 `log4j.xml` this file replaces, in Phase 3 of the Java 21 migration.
  NGB used to bind slf4j to log4j 1.2.17 through slf4j-log4j12; there is no slf4j-log4j12 for the
  slf4j 2.x that Spring Boot 3 requires, so logging now goes through spring-boot-starter-log4j2 and
  the configuration has to be in log4j2's own dialect.

  The translation is one-for-one:
    ConsoleAppender + Target=System.out            -> <Console target="SYSTEM_OUT">
    param Encoding=UTF-8                           -> PatternLayout charset="UTF-8"
    param Threshold=X                              -> <ThresholdFilter level="X" .../>
    DailyRollingFileAppender (default DatePattern) -> <RollingFile> + TimeBasedTriggeringPolicy,
                                                      filePattern ".log.%d{yyyy-MM-dd}", which is the
                                                      name log4j 1 rolled to
    <category name="x"><priority value="Y"/>       -> <Logger name="x" level="Y"/>
    <root><level value="Y"/>                       -> <Root level="Y">
  Conversion patterns are unchanged - %-5p, %d{...}, %c{1}, %t, %F, %L, %m%n mean the same thing in
  both. Loggers that carried no level keep carrying none, so they still inherit the root level.

  Two things deliberately not carried over:
   - `MaxBackupIndex=30` on requests-debug-appender. log4j 1's DailyRollingFileAppender has no such
     property (it is RollingFileAppender's), so DOMConfigurator warned and ignored it: the file was
     never capped, and adding a cap here would be a behaviour change, not a translation.
   - the `com.mchange` logger, which existed to quieten c3p0's very chatty INFO output. c3p0 is out
     of the build (D9); HikariCP logs two lines at startup and needs no muzzle.
-->
<Configuration>
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout charset="UTF-8" pattern="%-5p [%d{dd/MM/yyyy HH:mm:ss}][%c{1}] %m%n"/>
        </Console>

        <RollingFile name="debug-appender" fileName="./logs/catgenome-debug.log"
                     filePattern="./logs/catgenome-debug.log.%d{yyyy-MM-dd}">
            <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout charset="UTF-8" pattern="%-5p [%d{dd/MM/yyyy HH:mm:ss}][%t][%c] %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>

        <RollingFile name="requests-debug-appender" fileName="./logs/requests.log"
                     filePattern="./logs/requests.log.%d{yyyy-MM-dd}">
            <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout charset="UTF-8"
                           pattern='{"debug_level":"%p","debug_timestamp":"%d{dd/MM/yyyy HH:mm:ss}","debug_thread":"%t","debug_file":"%F", "debug_line":"%L","debug_message":"%m"}%n'/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>

        <RollingFile name="error-appender" fileName="./logs/catgenome-error.log"
                     filePattern="./logs/catgenome-error.log.%d{yyyy-MM-dd}">
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout charset="UTF-8" pattern="%-5p [%d{dd/MM/yyyy HH:mm:ss}][%t][%c] %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="com.epam.catgenome.app.CustomRequestLoggingFilter" additivity="false">
            <AppenderRef ref="requests-debug-appender"/>
        </Logger>

        <Logger name="org.springframework.aop.framework.CglibAopProxy" level="ERROR"/>
        <Logger name="org.apache.http.wire" level="ERROR"/>
        <Logger name="org.apache.http" level="ERROR"/>
        <Logger name="com.amazonaws" level="ERROR"/>
        <Logger name="com.epam.gene.catgenome" level="DEBUG"/>
        <Logger name="org.apache.commons.beanutils" level="WARN"/>
        <Logger name="org.springframework.jndi" level="ERROR"/>

        <Root level="DEBUG">
            <AppenderRef ref="stdout"/>
            <AppenderRef ref="debug-appender"/>
            <AppenderRef ref="error-appender"/>
        </Root>
    </Loggers>
</Configuration>
