<?xml version="1.0" encoding="UTF-8"?>
<beans xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/tx
                           http://www.springframework.org/schema/tx/spring-tx.xsd
                           http://www.springframework.org/schema/aop
                           http://www.springframework.org/schema/aop/spring-aop.xsd"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans" xmlns:tx="http://www.springframework.org/schema/tx"
       xmlns:aop="http://www.springframework.org/schema/aop">

    <!-- Configures database connection pool used to establish and manage connections to a content
         database. It is required to support interaction between database server and application

         HikariCP since Phase 3 of the Java 21 migration (D9); it was c3p0's ComboPooledDataSource,
         last released in 2015. Every `database.*` property name is unchanged - only the pool's own
         setter names differ:
             user               -> username
             jdbcUrl            -> jdbcUrl              (same)
             driverClass        -> driverClassName
             maxPoolSize        -> maximumPoolSize
             initialPoolSize    -> minimumIdle
         `initialPoolSize` is the one that is not an exact equivalent: c3p0 opened that many
         connections eagerly at startup, whereas Hikari's minimumIdle is the floor it keeps *idle*
         and it fills the pool lazily. Same steady state, no eager connect - and Hikari defaults
         minimumIdle to maximumPoolSize, which for `database.initial.pool.size=5` against
         `max.pool.size=25` would be a real change, so it is set explicitly.
    -->
    <bean id="dataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <property name="username" value="${database.username}"/>
        <property name="password" value="${database.password}"/>
        <property name="jdbcUrl" value="${database.jdbc.url}"/>
        <property name="driverClassName" value="${database.driver.class}"/>
        <property name="maximumPoolSize" value="${database.max.pool.size}"/>
        <property name="minimumIdle" value="${database.initial.pool.size}"/>
        <!-- H2 2.x (Phase 5 of the Java 21 migration) promoted USER, VALUE and END to reserved
             words, and this schema uses all three: the table CATGENOME.USER, catgenome.metadata's
             VALUE column and catgenome.session's END column. `SET NON_KEYWORDS` restores 1.x
             behaviour for exactly those three identifiers and nothing else, which is far less
             invasive than renaming them across 59 migration scripts and 42 DAO definitions.

             Driven off the JDBC URL rather than a property so that operators do not have to add
             anything to an existing catgenome.properties on upgrade, and so PostgreSQL - which
             needs none of this - is unaffected. Hikari runs it on every physical connection, Flyway
             included, since it is session scoped. -->
        <property name="connectionInitSql"
                  value="#{'${database.jdbc.url}'.startsWith('jdbc:h2:') ? 'SET NON_KEYWORDS END,USER,VALUE' : null}"/>
    </bean>

    <!-- Enables the annotations-based configuration for transactional behavior  -->
    <aop:config proxy-target-class="true"/>
    <tx:annotation-driven transaction-manager="txManager"/>
    <bean class="org.springframework.jdbc.datasource.DataSourceTransactionManager" id="txManager">
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <!-- Registers JdbcTemplate bean to use it among all DAO instances -->
    <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
        <property name="dataSource" ref="dataSource"/>
    </bean>

