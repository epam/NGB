# Lombok emitted @java.beans.ConstructorProperties on every constructor it generated up to and
# including 1.16.16; 1.16.20 turned that off by default. Jackson uses that annotation as an
# implicit properties-based creator, and this code base leans on it: ~90 classes carry @Builder
# (often with @Value) and no no-arg constructor, and about a third of them are deserialised from
# JSON - external-database responses, controller request bodies, NGBSessionValue. Without the
# annotation Jackson reports "no Creators, like default constructor, exist" at runtime.
#
# So restore the pre-bump behaviour globally rather than annotate the classes one by one: the set
# that matters cannot be enumerated reliably from the source, and the failure mode is a silent
# runtime one - PermissionHelper.sessionIsReadable, for instance, catches the IOException and
# denies access.
lombok.anyConstructor.addConstructorProperties = true

# Nothing above `server/` is a Java source tree.
config.stopBubbling = true
